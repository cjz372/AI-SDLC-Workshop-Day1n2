# Required in production (min 32 chars)
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
# WebAuthn relying party (must match the site's domain/origin)
RP_ID=localhost
RP_NAME="Todo App"
RP_ORIGIN=http://localhost:3000
# Optional: directory holding todos.db (e.g. Railway volume mount)
# RAILWAY_VOLUME_MOUNT_PATH=/app/data
